# Copy to .env.local (and add the same vars in Vercel → Settings → Environment Variables)

# API key from https://resend.com/api-keys (use the academy's own Resend account)
RESEND_API_KEY=

# Inbox that receives new free-trial bookings
TRIAL_NOTIFICATION_EMAIL=

# Sender address on a domain verified in Resend. Without it, onboarding@resend.dev
# is used, which only delivers to the Resend account owner (parents won't get emails).
RESEND_FROM_EMAIL="ProGoal Academy <hello@progoalacademy.com.au>"
